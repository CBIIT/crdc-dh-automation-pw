# Katalon profile CRDC_QA2.
# Copy to qa2.yaml and fill Email / Password / Secret from that .glbl.
# qa2.yaml is gitignored. Do not commit secrets.
name: qa2
base_url: https://hub-qa2.datacommons.cancer.gov/

AdminEmail:
AdminPassword:
AdminSecret:

FedleadEmail:
FedleadPassword:
FedleadSecret:

DcpEmail:
DcpPassword:
DcpSecret:

SubmitterEmail:
SubmitterPassword:
SubmitterSecret:

UserEmail:
UserPassword:
UserSecret:

MasterEmail:
MasterPassword:
MasterSecret:

# Upload CLI (CRDCDH-1405 TC101). ApiUrl is optional (defaults to base_url + api/graphql).
# SubmitterApiToken is a secret: copy it from the Katalon profile, never commit it.
ApiUrl: https://hub-qa2.datacommons.cancer.gov/api/graphql
SubmitterApiToken:
excel_ds_validation:
  enabled: true
  excel_cases_glob: tests/DataValidation/**/*.xlsx
