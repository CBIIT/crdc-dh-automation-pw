# Katalon profile CRDC_STAGE.
# Copy to stage.yaml and fill Email / Password / Secret from that .glbl.
# stage.yaml is gitignored. Do not commit secrets.
name: stage
base_url: https://hub-stage.datacommons.cancer.gov/

AdminEmail:
AdminPassword:
AdminSecret:

FedleadEmail:
FedleadPassword:
FedleadSecret:

DcpEmail:
DcpPassword:
DcpSecret:

SubmitterEmail:
SubmitterPassword:
SubmitterSecret:

UserEmail:
UserPassword:
UserSecret:

MasterEmail:
MasterPassword:
MasterSecret:

# Upload CLI (CRDCDH-1405 TC101). ApiUrl is optional (defaults to base_url + api/graphql).
# SubmitterApiToken is a secret: copy it from the Katalon profile, never commit it.
ApiUrl: https://hub-stage.datacommons.cancer.gov/api/graphql
SubmitterApiToken:
# Optional CLI settings (Katalon profile names; defaults shown, leave out to use them):
# CRDC_CLI_RETRIES: 3
# CRDC_CLI_OVERWRITE: false
# CRDC_CLI_DRYRUN: false

excel_ds_validation:
  enabled: true
  excel_cases_glob: tests/DataValidation/**/*.xlsx
