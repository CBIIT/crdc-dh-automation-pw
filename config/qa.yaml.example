# Katalon profile CRDC_QA.
# Copy to qa.yaml and fill Email / Password / Secret from that .glbl.
# qa.yaml is gitignored. Do not commit secrets.
name: qa
base_url: https://hub-qa.datacommons.cancer.gov/

AdminEmail:
AdminPassword:
AdminSecret:

FedleadEmail:
FedleadPassword:
FedleadSecret:

DcpEmail:
DcpPassword:
DcpSecret:

SubmitterEmail:
SubmitterPassword:
SubmitterSecret:

UserEmail:
UserPassword:
UserSecret:

MasterEmail:
MasterPassword:
MasterSecret:

# Upload CLI (CRDCDH-1405 TC101). ApiUrl is optional (defaults to base_url + api/graphql).
# SubmitterApiToken is a secret: copy it from the Katalon profile, never commit it.
ApiUrl: https://hub-qa.datacommons.cancer.gov/api/graphql
SubmitterApiToken:
# Optional CLI settings (Katalon profile names; defaults shown, leave out to use them):
# CRDC_CLI_RETRIES: 3
# CRDC_CLI_OVERWRITE: false
# CRDC_CLI_DRYRUN: false
# CRDC_MANIFEST_ID_FIELD:      # manifest column that holds the file id
# CRDC_CLI_PYTHON:             # interpreter for the CLI (needs 3.13+); default is the one running pytest

# Excel-driven metadata VR cases (tests/DataValidation/**/*.xlsx). See docs/excel-ds-validation.md.
excel_ds_validation:
  enabled: true
  excel_cases_glob: tests/DataValidation/**/*.xlsx
