# Katalon profile CRDC_QA.
# Copy to qa.yaml and fill Email / Password / Secret from that .glbl.
# qa.yaml is gitignored. Do not commit secrets.
name: qa
base_url: https://hub-qa.datacommons.cancer.gov/

AdminEmail:
AdminPassword:
AdminSecret:

FedleadEmail:
FedleadPassword:
FedleadSecret:

DcpEmail:
DcpPassword:
DcpSecret:

SubmitterEmail:
SubmitterPassword:
SubmitterSecret:

UserEmail:
UserPassword:
UserSecret:

MasterEmail:
MasterPassword:
MasterSecret:

# Excel-driven metadata VR cases (tests/DataValidation/**/*.xlsx). See docs/excel-ds-validation.md.
excel_ds_validation:
  enabled: true
  excel_cases_glob: tests/DataValidation/**/*.xlsx
